# このファイルを .env という名前でコピーして値を書き換える（.env は git に入れない）

# --- Gemini API（https://aistudio.google.com/apikey で発行） ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# --- AI の切替: gemini | ollama | mock ---
AI_BACKEND=gemini
OLLAMA_URL=http://localhost:11434
OLLAMA_VLM=qwen2.5vl:7b
OLLAMA_LLM=qwen2.5vl:7b

# --- ロボット（lerobot-find-port で確認。id はキャリブレーション時と同じ） ---
ROBOT_PORT=COM5
ROBOT_ID=my_follower
TELEOP_PORT=COM4
TELEOP_ID=my_leader

# --- lerobot の CLI 置き場。.venv を使うなら空のままでよい ---
LEROBOT_BIN=

# --- カメラ（lerobot-find-cameras opencv で確認） ---
CAMERA_INDEX=0
CAPTURE_WIDTH=1280
CAPTURE_HEIGHT=720

# --- 再生1回の上限秒数 ---
REPLAY_TIMEOUT_S=120

# --- 表示ウィンドウの位置と幅（撮影用） ---
WINDOW_X=0
WINDOW_Y=0
WINDOW_W=960

# --- 手首の回転を固定（度）。tools/patch_wrist_lock.py を実行したあとに有効。空にするとリーダーに追従 ---
LOCK_WRIST_ROLL=0
